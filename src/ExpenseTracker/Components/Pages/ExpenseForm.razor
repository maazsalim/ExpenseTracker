@page "/expenses/new"
@page "/expenses/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject ExpenseConverter Converter
@inject IOptions<CurrencyOptions> CurrencyOptions

<PageTitle>@Title · ExpenseTracker</PageTitle>

<div class="page-header">
    <div>
        <a href="" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            Back to expenses
        </a>
        <h1>@Title</h1>
        <p>@(Id is null ? "Record a new expense." : "Update the details of this expense.")</p>
    </div>
</div>

<div class="card-panel form-card">
    @if (!loaded)
    {
        <div class="loading">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading…
        </div>
    }
    else if (expense is null)
    {
        <div class="empty-state">
            <h2>Expense not found</h2>
            <p class="mb-3">It may have been deleted.</p>
            <a href="" class="btn btn-light">Back to expenses</a>
        </div>
    }
    else
    {
        <EditForm Model="expense" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="card-panel-body">
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <InputText id="description" class="form-control" placeholder="e.g. Weekly groceries" @bind-Value="expense.Description" />
                    <ValidationMessage For="() => expense.Description" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="amount">Amount</label>
                        <div class="input-group">
                            <InputNumber id="amount" class="form-control" step="0.01" @bind-Value="expense.Amount" />
                            <InputSelect class="form-select currency-select" aria-label="Currency" @bind-Value="expense.Currency">
                                @foreach (var currency in Currencies.Supported)
                                {
                                    <option value="@currency">@currency</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="() => expense.Amount" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="date">Date</label>
                        <InputDate id="date" class="form-control" @bind-Value="expense.Date" />
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between">
                        <label class="form-label" for="category">Category</label>
                        <a href="categories" class="small text-decoration-none">Manage categories</a>
                    </div>
                    <InputSelect id="category" class="form-select" @bind-Value="expense.CategoryId">
                        <option value="0">Select a category…</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => expense.CategoryId" />
                </div>
            </div>

            @if (error is not null)
            {
                <div class="alert alert-danger mx-3 mb-3" role="alert">@error</div>
            }

            <div class="form-actions">
                <a href="" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    @(Id is null ? "Add expense" : "Save changes")
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Expense? expense;
    private List<Category> categories = new();
    private bool loaded;
    private bool saving;
    private string? error;

    // What the stored conversion was based on, so an edit only re-fetches the rate when needed.
    private string? originalCurrency;
    private DateOnly originalDate;

    private string Title => Id is null ? "Add expense" : "Edit expense";

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.Categories.OrderBy(c => c.Name).ToListAsync();
        expense = Id is null
            ? new Expense { Currency = CurrencyOptions.Value.DefaultExpenseCurrency }
            : await db.Expenses.FindAsync(Id);
        originalCurrency = expense?.Currency;
        originalDate = expense?.Date ?? default;
        loaded = true;
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;

        if (Id is null || expense!.Currency != originalCurrency || expense.Date != originalDate)
        {
            try
            {
                await Converter.ConvertAsync(expense!);
            }
            catch (ExchangeRateUnavailableException ex)
            {
                error = $"{ex.Message} Check your connection and try again.";
                saving = false;
                return;
            }
        }
        else
        {
            ExpenseConverter.ApplyRates(expense!);
        }

        using var db = await DbFactory.CreateDbContextAsync();
        if (Id is null)
            db.Expenses.Add(expense!);
        else
            db.Expenses.Update(expense!);
        await db.SaveChangesAsync();
        Nav.NavigateTo("");
    }
}
