@page "/"
@page "/expenses"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject DisplayCurrency Display
@inject RecurringExpenseService Recurring
@implements IDisposable

<PageTitle>Expenses · Dual Expense Tracker</PageTitle>

<div class="page-header">
    <div>
        <h1>Expenses</h1>
        <p>Track and manage everything you spend.</p>
    </div>
    <div class="header-actions">
        <CurrencySwitch />
        <a href="expenses/new" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Add expense
        </a>
    </div>
</div>

@if (!loaded)
{
    <div class="card-panel loading">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading expenses…
    </div>
}
else
{
    <div class="stat-grid">
        <div class="card-panel stat-card">
            <div class="stat-label">This month</div>
            <div class="stat-value">@Display.Format(monthTotal)</div>
            <div class="stat-sub">@monthCount @(monthCount == 1 ? "expense" : "expenses") in @DateTime.Today.ToString("MMMM")</div>
        </div>
        <div class="card-panel stat-card">
            <div class="stat-label">Budget remaining</div>
            @if (budgetTotal > 0)
            {
                var remaining = budgetTotal - budgetSpent;
                <div class="stat-value @(remaining < 0 ? "text-over" : "")">@Display.Format(Math.Abs(remaining))@(remaining < 0 ? " over" : "")</div>
                <div class="breakdown-track mt-2">
                    <div class="breakdown-bar @(remaining < 0 ? "bar-over" : "bar-indigo")" style="width: @BudgetPercent%"></div>
                </div>
                <div class="stat-sub mt-1">@Display.Format(budgetSpent) of @BudgetLabel(budgetTotal) @(totalBudget is null ? "budgeted" : "overall budget")</div>
            }
            else
            {
                <div class="stat-value muted">—</div>
                <div class="stat-sub"><a href="categories">Set a monthly budget</a></div>
            }
        </div>
        <div class="card-panel stat-card">
            <div class="stat-label">Top category this month</div>
            <div class="stat-value">@(topCategory?.Name ?? "—")</div>
            <div class="stat-sub">@(topCategory is null ? "No spending yet" : $"{Display.Format(topCategory.Amount)} spent")</div>
        </div>
        <div class="card-panel stat-card">
            <div class="stat-label">All time</div>
            <div class="stat-value">@Display.Format(expenses.Sum(Display.Of))</div>
            <div class="stat-sub">@expenses.Count @(expenses.Count == 1 ? "expense" : "expenses") recorded</div>
        </div>
    </div>

    <div class="card-panel">
        @if (expenses.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" /><path d="M3 5v14a2 2 0 0 0 2 2h16v-5" /><path d="M18 12a2 2 0 0 0 0 4h4v-4Z" /></svg>
                </div>
                <h2>No expenses yet</h2>
                <p class="mb-3">Add your first expense to start tracking your spending.</p>
                <a href="expenses/new" class="btn btn-primary">Add expense</a>
            </div>
        }
        else
        {
            <div class="card-panel-header">
                <div class="input-icon flex-grow-1" style="max-width: 320px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input class="form-control" placeholder="Search descriptions…" aria-label="Search descriptions"
                           @bind="search" @bind:event="oninput" />
                </div>
                <select class="form-select w-auto" aria-label="Filter by category" @bind="categoryFilter">
                    <option value="0">All categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <select class="form-select w-auto" aria-label="Filter by account" @bind="accountFilter">
                    <option value="@AllAccounts">All accounts</option>
                    @foreach (var a in accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                    <option value="@NoAccount">Not set</option>
                </select>
            </div>

            @if (Filtered.Count == 0)
            {
                <div class="empty-state">
                    <h2>No matching expenses</h2>
                    <p class="mb-0">Try a different search, category or account.</p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    @* On phones each row becomes a compact card (see .expense-table in app.css). *@
                    <table class="data-table expense-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th class="num">Amount</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Filtered)
                            {
                                <tr>
                                    <td class="col-date muted text-nowrap">@e.Date.ToString("dd MMM yyyy")</td>
                                    <td class="col-desc">
                                        <div class="fw-medium">
                                            @e.Description
                                            @if (e.RecurringExpenseId is not null)
                                            {
                                                <span class="recurring-mark" title="Added by a recurring item">↻</span>
                                            }
                                        </div>
                                        @if (e.Account is not null)
                                        {
                                            <div class="muted small">@e.Account.Name</div>
                                        }
                                    </td>
                                    <td class="col-cat"><span class="cat-badge cat-@e.Category?.Color">@e.Category?.Name</span></td>
                                    <td class="col-amount num fw-semibold text-nowrap">
                                        @Money.Format(e.Amount, e.Currency)
                                        @if (e.Currency != Display.Current)
                                        {
                                            <span class="amount-converted" title="@($"1 {e.Currency} = {Display.RateOf(e):0.######} {Display.Current} on {e.RateDate:d MMM yyyy}")">@Display.Format(Display.Of(e))</span>
                                        }
                                    </td>
                                    <td class="col-actions">
                                        <div class="row-actions">
                                            @if (pendingDeleteId == e.Id)
                                            {
                                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(e)">Delete</button>
                                                <button class="btn btn-sm btn-light" @onclick="() => pendingDeleteId = null">Cancel</button>
                                            }
                                            else
                                            {
                                                <a href="expenses/@e.Id" class="btn btn-icon" title="Edit" aria-label="Edit @e.Description">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                                </a>
                                                <button class="btn btn-icon danger" title="Delete" aria-label="Delete @e.Description" @onclick="() => pendingDeleteId = e.Id">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" /></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="col-desc" colspan="3">@Filtered.Count @(Filtered.Count == 1 ? "expense" : "expenses")</td>
                                <td class="col-amount num text-nowrap">@Display.Format(Filtered.Sum(Display.Of))</td>
                                <td class="col-actions"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        }
    </div>

    @* Thumb-reachable "add" button, shown on phones only. *@
    <a href="expenses/new" class="fab" aria-label="Add expense">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    </a>
}

@code {
    private record CategoryTotal(string Name, decimal Amount);

    private List<Expense> expenses = new();
    private List<Category> categories = new();
    private List<Account> accounts = new();
    private bool loaded;

    private const int AllAccounts = 0;
    private const int NoAccount = -1;

    private string search = "";
    private int categoryFilter;
    private int accountFilter = AllAccounts;
    private int? pendingDeleteId;

    private decimal monthTotal;
    private int monthCount;
    private CategoryTotal? topCategory;
    private decimal budgetTotal;
    private decimal budgetSpent;
    private decimal? totalBudget;

    // Budgets are set in CAD, so in AED they're converted at today's rate (approximate).
    private string BudgetLabel(decimal amount) => (Display.ShowingSecondary ? "≈ " : "") + Display.Format(amount);

    private int BudgetPercent => budgetTotal == 0 ? 0 : (int)Math.Min(100, Math.Round(budgetSpent / budgetTotal * 100));

    private List<Expense> Filtered => expenses
        .Where(e => categoryFilter == 0 || e.CategoryId == categoryFilter)
        .Where(e => accountFilter switch
        {
            AllAccounts => true,
            NoAccount => e.AccountId is null,
            var id => e.AccountId == id,
        })
        .Where(e => string.IsNullOrWhiteSpace(search)
                    || e.Description.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Add any recurring expenses that came due since the app was last opened.
        await Recurring.RunOnceAsync();

        using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.Categories.OrderBy(c => c.Name).ToListAsync();
        accounts = await db.Accounts.OrderBy(a => a.Name).ToListAsync();
        expenses = await db.Expenses
            .Include(e => e.Category)
            .Include(e => e.Account)
            .OrderByDescending(e => e.Date)
            .ThenByDescending(e => e.Id)
            .ToListAsync();
        totalBudget = (await db.Settings.SingleOrDefaultAsync())?.TotalMonthlyBudget;
        ComputeStats();
        Display.Changed += OnDisplayCurrencyChanged;
        loaded = true;
    }

    private void OnDisplayCurrencyChanged() => InvokeAsync(() =>
    {
        ComputeStats();
        StateHasChanged();
    });

    public void Dispose() => Display.Changed -= OnDisplayCurrencyChanged;

    private void ComputeStats()
    {
        var today = DateTime.Today;
        var thisMonth = expenses.Where(e => e.Date.Year == today.Year && e.Date.Month == today.Month).ToList();
        monthTotal = thisMonth.Sum(Display.Of);
        monthCount = thisMonth.Count;
        topCategory = thisMonth
            .GroupBy(e => e.Category?.Name ?? "Uncategorised")
            .Select(g => new CategoryTotal(g.Key, g.Sum(Display.Of)))
            .OrderByDescending(c => c.Amount)
            .FirstOrDefault();

        // An overall budget covers all spending.
        if (totalBudget is { } overall)
        {
            budgetTotal = Display.Budget(overall);
            budgetSpent = monthTotal;
            return;
        }

        // Otherwise only spending in categories that have a budget counts against them.
        var budgeted = categories.Where(c => c.MonthlyBudget is not null).ToList();
        budgetTotal = Display.Budget(budgeted.Sum(c => c.MonthlyBudget!.Value));
        budgetSpent = thisMonth
            .Where(e => budgeted.Any(c => c.Id == e.CategoryId))
            .Sum(Display.Of);
    }

    private async Task DeleteAsync(Expense e)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        await db.Expenses.Where(x => x.Id == e.Id).ExecuteDeleteAsync();
        expenses.Remove(e);
        pendingDeleteId = null;
        ComputeStats();
    }
}
