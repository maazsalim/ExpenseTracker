@page "/summary"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject DisplayCurrency Display
@inject RecurringExpenseService Recurring
@implements IDisposable

<PageTitle>Summary · ExpenseTracker</PageTitle>

<div class="page-header">
    <div>
        <h1>Monthly summary</h1>
        <p>See where your money went: by category, currency and account.</p>
    </div>
    <div class="header-actions">
    <CurrencySwitch />
    <div class="month-nav">
        <button class="btn btn-icon" title="Previous month" aria-label="Previous month" @onclick="() => ChangeMonth(-1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <span class="month-label">@month.ToString("MMMM yyyy")</span>
        <button class="btn btn-icon" title="Next month" aria-label="Next month" @onclick="() => ChangeMonth(1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
    </div>
    </div>
</div>

@if (!loaded)
{
    <div class="card-panel loading">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading summary…
    </div>
}
else
{
    <div class="stat-grid">
        <div class="card-panel stat-card">
            <div class="stat-label">Total spent</div>
            <div class="stat-value">@Display.Format(total)</div>
            <div class="stat-sub">@count @(count == 1 ? "expense" : "expenses")</div>
        </div>
        <div class="card-panel stat-card">
            <div class="stat-label">Daily average</div>
            <div class="stat-value">@Display.Format(DailyAverage)</div>
            <div class="stat-sub">over @DaysCounted @(DaysCounted == 1 ? "day" : "days")</div>
        </div>
        <div class="card-panel stat-card">
            <div class="stat-label">Top category</div>
            <div class="stat-value">@(Spending.FirstOrDefault()?.Name ?? "—")</div>
            <div class="stat-sub">@(Spending.Count == 0 ? "No spending" : $"{Percent(Spending[0])}% of total")</div>
        </div>
    </div>

    @if (count > 0)
    {
        <div class="summary-split mb-4">
            <div class="card-panel">
                <div class="card-panel-header">
                    <h2 class="fs-6 fw-semibold mb-0">Paid in</h2>
                </div>
                <div class="card-panel-body">
                    @foreach (var c in byCurrency)
                    {
                        <div class="split-row">
                            <span>@c.Currency <span class="muted small">· @c.Count @(c.Count == 1 ? "expense" : "expenses")</span></span>
                            <span class="num fw-semibold">@Money.Format(c.Amount, c.Currency)</span>
                        </div>
                    }
                    <div class="split-row split-total">
                        <span>Total in @Display.Current</span>
                        <span class="num fw-semibold">@Display.Format(total)</span>
                    </div>
                </div>
            </div>

            <div class="card-panel">
                <div class="card-panel-header">
                    <h2 class="fs-6 fw-semibold mb-0">Paid with</h2>
                    <a href="accounts" class="small fw-medium text-decoration-none">Manage accounts</a>
                </div>
                <div class="card-panel-body">
                    @foreach (var a in byAccount)
                    {
                        <div class="split-row">
                            <span>@a.Name <span class="muted small">· @a.Count @(a.Count == 1 ? "expense" : "expenses")</span></span>
                            <span class="num fw-semibold">@Display.Format(a.Amount)</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card-panel mb-4">
        <div class="card-panel-header">
            <h2 class="fs-6 fw-semibold mb-0">Budgets</h2>
            <a href="categories" class="small fw-medium text-decoration-none">Manage budgets</a>
        </div>

        @if (Budgeted.Count == 0 && totalBudget is null)
        {
            <div class="empty-state">
                <h2>No budgets set</h2>
                <p class="mb-3">Give a category a monthly budget to track it here.</p>
                <a href="categories" class="btn btn-light">Set a budget</a>
            </div>
        }
        else
        {
            <div class="card-panel-body">
                @if (totalBudget is { } overall)
                {
                    var overallLeft = overall - total;
                    <div class="breakdown-row">
                        <div class="breakdown-top">
                            <span class="fw-semibold">Overall</span>
                            <span class="num">
                                <span class="fw-semibold @(overallLeft < 0 ? "text-over" : "")">@Display.Format(total)</span>
                                <span class="muted"> / @BudgetText(overall)</span>
                            </span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-bar @(overallLeft < 0 ? "bar-over" : "bar-indigo")" style="width: @Percent(total, overall)%"></div>
                        </div>
                        <div class="budget-meta">
                            <span class="muted">@((int)Math.Round(total / overall * 100))% used</span>
                            @if (overallLeft < 0)
                            {
                                <span class="text-over">@Display.Format(-overallLeft) over</span>
                            }
                            else
                            {
                                <span class="muted">@Display.Format(overallLeft) left</span>
                            }
                        </div>
                    </div>
                }
                @foreach (var r in Budgeted)
                {
                    var budget = r.Budget!.Value;
                    var remaining = budget - r.Amount;
                    <div class="breakdown-row">
                        <div class="breakdown-top">
                            <span class="cat-badge cat-@r.Color">@r.Name</span>
                            <span class="num">
                                <span class="fw-semibold @(remaining < 0 ? "text-over" : "")">@Display.Format(r.Amount)</span>
                                <span class="muted"> / @BudgetText(budget)</span>
                            </span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-bar @(remaining < 0 ? "bar-over" : $"bar-{r.Color}")" style="width: @BudgetPercent(r)%"></div>
                        </div>
                        <div class="budget-meta">
                            <span class="muted">@((int)Math.Round(r.Amount / budget * 100))% used</span>
                            @if (remaining < 0)
                            {
                                <span class="text-over">@Display.Format(-remaining) over</span>
                            }
                            else
                            {
                                <span class="muted">@Display.Format(remaining) left</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card-panel">
        <div class="card-panel-header">
            <h2 class="fs-6 fw-semibold mb-0">Spending by category</h2>
        </div>

        @if (Spending.Count == 0)
        {
            <div class="empty-state">
                <h2>No expenses this month</h2>
                <p class="mb-0">Pick another month or add some expenses.</p>
            </div>
        }
        else
        {
            <div class="card-panel-body">
                @foreach (var r in Spending)
                {
                    <div class="breakdown-row">
                        <div class="breakdown-top">
                            <span class="cat-badge cat-@r.Color">@r.Name</span>
                            <span class="num">
                                <span class="fw-semibold">@Display.Format(r.Amount)</span>
                                <span class="muted ms-2">@Percent(r)%</span>
                            </span>
                        </div>
                        <div class="breakdown-track">
                            <div class="breakdown-bar bar-@r.Color" style="width: @Percent(r)%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    // Budgets are set in CAD, so in AED they're converted at today's rate (approximate).
    private string BudgetText(decimal budget) => (Display.ShowingSecondary ? "≈ " : "") + budget.ToString("N2");

    // Amount and Budget are in the display currency.
    private record CategoryTotal(string Name, string Color, decimal? Budget, decimal Amount);

    // Amount is in the currency itself (what you actually paid in it).
    private record CurrencyTotal(string Currency, decimal Amount, int Count);

    // Amount is in the display currency.
    private record AccountTotal(string Name, decimal Amount, int Count);

    private DateOnly month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<CategoryTotal> rows = new();
    private List<CurrencyTotal> byCurrency = new();
    private List<AccountTotal> byAccount = new();
    private decimal total;
    private decimal? totalBudget;
    private int count;
    private bool loaded;

    private List<CategoryTotal> Spending => rows.Where(r => r.Amount > 0).OrderByDescending(r => r.Amount).ToList();
    private List<CategoryTotal> Budgeted => rows.Where(r => r.Budget is not null).OrderBy(r => r.Name).ToList();

    // For the current month only count days elapsed so far; past months use the full month.
    private int DaysCounted
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            if (today.Year == month.Year && today.Month == month.Month)
                return today.Day;
            return DateTime.DaysInMonth(month.Year, month.Month);
        }
    }

    private decimal DailyAverage => total / DaysCounted;

    protected override async Task OnInitializedAsync()
    {
        // Add any recurring expenses that came due since the app was last opened.
        await Recurring.RunOnceAsync();
        await LoadAsync();
        Display.Changed += OnDisplayCurrencyChanged;
    }

    private void OnDisplayCurrencyChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Display.Changed -= OnDisplayCurrencyChanged;

    private async Task ChangeMonth(int delta)
    {
        month = month.AddMonths(delta);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var start = month;
        var end = month.AddMonths(1);

        var secondary = Display.ShowingSecondary;

        using var db = await DbFactory.CreateDbContextAsync();
        rows = (await db.Categories
            .Select(c => new CategoryTotal(
                c.Name,
                c.Color,
                c.MonthlyBudget,
                c.Expenses.Where(e => e.Date >= start && e.Date < end)
                    .Sum(e => secondary ? e.AmountInSecondary : e.AmountInHome)))
            .ToListAsync())
            .Select(r => r with { Budget = r.Budget is { } b ? Display.Budget(b) : null })
            .ToList();
        count = await db.Expenses.CountAsync(e => e.Date >= start && e.Date < end);

        var inMonth = db.Expenses.Where(e => e.Date >= start && e.Date < end);
        byCurrency = await inMonth
            .GroupBy(e => e.Currency)
            .OrderBy(g => g.Key)
            .Select(g => new CurrencyTotal(g.Key, g.Sum(e => e.Amount), g.Count()))
            .ToListAsync();

        var accountNames = await db.Accounts.ToDictionaryAsync(a => a.Id, a => a.Name);
        byAccount = (await inMonth
            .GroupBy(e => e.AccountId)
            .Select(g => new { AccountId = g.Key, Amount = g.Sum(e => secondary ? e.AmountInSecondary : e.AmountInHome), Count = g.Count() })
            .ToListAsync())
            .Select(g => new AccountTotal(
                g.AccountId is { } id && accountNames.TryGetValue(id, out var name) ? name : "Not set",
                g.Amount,
                g.Count))
            .OrderByDescending(a => a.Amount)
            .ToList();

        total = rows.Sum(r => r.Amount);
        totalBudget = (await db.Settings.SingleAsync()).TotalMonthlyBudget is { } t ? Display.Budget(t) : null;
        loaded = true;
    }

    private int Percent(CategoryTotal r) =>
        total == 0 ? 0 : (int)Math.Round(r.Amount / total * 100);

    private static int BudgetPercent(CategoryTotal r) =>
        r.Budget is not > 0 ? 0 : Percent(r.Amount, r.Budget.Value);

    private static int Percent(decimal spent, decimal budget) =>
        budget <= 0 ? 0 : (int)Math.Min(100, Math.Round(spent / budget * 100));
}
