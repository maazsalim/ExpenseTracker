<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Replaces Blazor's default "Rejoining the server" dialog. iOS pauses the installed app in the
   background, which drops the live connection; this reconnects (or reloads) quietly instead,
   showing only a small pill if it takes a moment. Blazor sends its reconnect events to this
   element's id, so keep it. *@
<dialog id="components-reconnect-modal" data-nosnippet aria-live="polite">
    <span class="reconnect-spinner" aria-hidden="true"></span>
    Reconnecting…
</dialog>
