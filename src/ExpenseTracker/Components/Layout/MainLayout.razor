@inherits LayoutComponentBase
@inject DemoAccount Demo

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <AuthorizeView>
            <Authorized>
                @if (Demo.Email is not null && string.Equals(context.User.Identity?.Name, Demo.Email, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="demo-banner" role="note">
                        <strong>Demo account.</strong> The data is made up and resets every day, so feel free to try anything.
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
