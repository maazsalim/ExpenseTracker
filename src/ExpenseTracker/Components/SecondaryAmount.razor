@* A home-currency amount shown again, smaller, in the secondary currency at today's rate. *@
@inject SecondaryCurrencyRate Secondary

@if (quote is not null)
{
    <span class="amount-secondary @(Inline ? "inline" : "")"
          title="@($"At today's rate: 1 {Secondary.Home} = {quote.Rate:0.####} {Secondary.Currency}")">@Prefix≈ @Money.Format(Money.Convert(Value, quote.Rate), Secondary.Currency)@Suffix</span>
}

@code {
    /// <summary>The amount in the home currency.</summary>
    [Parameter, EditorRequired] public decimal Value { get; set; }

    /// <summary>Text before the "≈", e.g. " (".</summary>
    [Parameter] public string? Prefix { get; set; }

    /// <summary>Text after the amount, e.g. " over".</summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>Flow with surrounding text instead of on its own line.</summary>
    [Parameter] public bool Inline { get; set; }

    private FxQuote? quote;

    protected override async Task OnInitializedAsync() => quote = await Secondary.GetAsync();
}
